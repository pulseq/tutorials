# Format of extension lists:
# id type ref next_id
# next_id of 0 terminates the list
# Extension list is followed by extension specifications
[EXTENSIONS]
1 1 5 0
2 1 6 1
3 1 7 0
4 1 8 3
5 1 9 0
6 1 10 0
7 1 3 0
8 1 4 7
9 3 2 0
10 1 1 0
11 1 2 10
12 3 3 0
13 1 4 10
14 3 4 0
15 3 1 0
16 3 5 0

# Extension specification for setting labels:
# id set labelstring
extension LABELSET 1
1 1 REF
2 1 IMA
3 0 REF
4 0 IMA
5 1 NOISE
6 1 ONCE
7 0 NOISE
8 0 ONCE
9 0 SLC
10 0 LIN

# Extension specification for increasing labels:
# id inc labelstring
extension LABELINC 3
1 1 SLC
2 2 LIN
3 1 LIN
4 0 LIN
5 1 REP

